{
  "dataRoles": [
    {
      "displayName": "Values",
      "displayNameKey": "Role_measure",
      "name": "measure",
      "kind": "Measure",
      "description": "Numeric field to plot as histogram"
    },
    {
      "displayName": "Detail (rows)",
      "displayNameKey": "Role_category",
      "name": "category",
      "kind": "Grouping",
      "description": "Optional category for row-level data"
    },
    {
      "displayName": "Tooltips",
      "displayNameKey": "Role_tooltips",
      "name": "tooltips",
      "kind": "Measure",
      "description": "Optional measures shown in the tooltip (displayed as average per bin)"
    },
    {
      "displayName": "Small multiples (Pro)",
      "displayNameKey": "Role_panel",
      "name": "panel",
      "kind": "Grouping",
      "description": "One histogram per value of this field — region, product, channel — on a shared axis."
    }
  ],
  "dataViewMappings": [
    {
      "categorical": {
        "categories": {
          "select": [
            {
              "for": {
                "in": "category"
              }
            },
            {
              "bind": {
                "to": "panel"
              }
            }
          ],
          "dataReductionAlgorithm": {
            "window": {
              "count": 30000
            }
          }
        },
        "values": {
          "select": [
            {
              "bind": {
                "to": "measure"
              }
            },
            {
              "for": {
                "in": "tooltips"
              }
            }
          ]
        }
      }
    }
  ],
  "objects": {
    "general": {
      "displayName": "General",
      "displayNameKey": "Obj_general",
      "properties": {
        "filter": {
          "type": {
            "filter": true
          }
        }
      }
    },
    "histogram": {
      "displayName": "Histogram",
      "displayNameKey": "Obj_histogram",
      "properties": {
        "bins": {
          "displayName": "Number of bins (Pro)",
          "displayNameKey": "Prop_histogram_bins",
          "description": "Number of bins. Free tier is fixed at 10. Upgrade to Pro for 2–100.",
          "type": {
            "numeric": true
          }
        },
        "trimLower": {
          "displayName": "Lower trim % (Pro)",
          "displayNameKey": "Prop_histogram_trimLower",
          "description": "Trim bottom N% of values as outliers. Pro only.",
          "type": {
            "numeric": true
          }
        },
        "trimUpper": {
          "displayName": "Upper trim % (Pro)",
          "displayNameKey": "Prop_histogram_trimUpper",
          "description": "Trim top N% of values as outliers. Pro only.",
          "type": {
            "numeric": true
          }
        },
        "barColor": {
          "displayName": "Bar color (Pro)",
          "displayNameKey": "Prop_histogram_barColor",
          "description": "Fill color of the bars. Supports conditional formatting (fx): each bin takes the color the rule gives its middle row.",
          "type": {
            "fill": {
              "solid": {
                "color": true
              }
            }
          },
          "rule": {
            "inputRole": "measure",
            "output": {
              "property": "barColor",
              "selector": [
                "category"
              ]
            }
          }
        },
        "barOpacity": {
          "displayName": "Bar opacity % (Pro)",
          "displayNameKey": "Prop_histogram_barOpacity",
          "type": {
            "numeric": true
          }
        },
        "borderColor": {
          "displayName": "Border color (Pro)",
          "displayNameKey": "Prop_histogram_borderColor",
          "type": {
            "fill": {
              "solid": {
                "color": true
              }
            }
          }
        },
        "borderWidth": {
          "displayName": "Border width (Pro)",
          "displayNameKey": "Prop_histogram_borderWidth",
          "type": {
            "numeric": true
          }
        },
        "barGap": {
          "displayName": "Bar gap px (Pro)",
          "displayNameKey": "Prop_histogram_barGap",
          "type": {
            "numeric": true
          }
        }
      }
    },
